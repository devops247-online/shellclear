#!/usr/bin/env bash
# Blocks `git push` unless Trivy finds no fixable HIGH or CRITICAL issues,
# secrets or license problems. Install with `make hooks`. CI and the release
# workflow run the full set of checks (scripts/security-scan.sh).
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

echo "pre-push: running Trivy (scripts/security-scan.sh trivy)"
if ! scripts/security-scan.sh trivy; then
	echo "" >&2
	echo "pre-push: Trivy check failed; the push was blocked." >&2
	exit 1
fi
